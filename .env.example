# Copy to .env and paste the team key. Never commit .env.
OPENAI_BASE_URL=https://ws.akamai-workshops.com/v1
OPENAI_API_KEY=paste_your_team_key_here
CHAT_MODEL=hackathon-chat

# NWS asks API clients to send a contact in the User-Agent, e.g. "closure-call (you@example.com)".
NWS_USER_AGENT=closure-call (Hack Midwest 2026)

# Decision record. Leave unset to use a local SQLite file (data/closure_call.db).
# Akamai Managed PostgreSQL (copy host, port, user and password from Cloud Manager):
# DATABASE_URL=postgresql+psycopg://linpostgres:PASSWORD@HOST:PORT/postgres?sslmode=require

# Web app
# BASE_URL=http://YOUR-LINODE-IP:8000      # used in links inside manager alerts
# MONITOR_MINUTES=15                        # background checks; 0 or unset turns the monitor off
# MONITOR_DAY=tomorrow                      # "next" (default) = next operating day; "tomorrow" for weekend demos
